---
import { u } from '../data/site';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found" description="This page went missing. Head back to the shop." noindex>
  <section class="nf page-head">
    <div class="wrap in">
      <div class="frame" aria-hidden="true">
        <div class="blank"><Icon name="camera" size={56} /></div>
        <p>oops, no photo here</p>
      </div>
      <div class="stack">
        <p class="eyebrow">Error 404</p>
        <h1 class="h1">This page went missing</h1>
        <p class="lede">The link may be old or mistyped. All the gifts are still here.</p>
        <div class="ctas">
          <a class="btn btn-pink" href={u('/shop')}>Go to the shop <Icon name="arrow" size={18} class="arrow" /></a>
          <a class="btn btn-line" href={u('/')}>Home</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(64px, 10vw, 128px); }
  .in { display: flex; flex-wrap: wrap; gap: 56px; align-items: center; }
  .frame { width: min(260px, 70vw); background: #fff; padding: 14px 14px 18px; border-radius: 14px; rotate: -4deg; box-shadow: 0 24px 48px -24px rgba(43, 27, 61, .4); }
  .blank { aspect-ratio: 1; border-radius: 8px; background: linear-gradient(135deg, var(--p-pink), var(--p-lav)); display: grid; place-items: center; color: var(--pink-deep); }
  .blank :global(svg) { animation: idle 3s ease-in-out infinite alternate; }
  .frame p { margin: 12px 0 0; text-align: center; font-weight: 600; color: var(--muted); font-size: 14px; }
  .stack { flex: 1 1 360px; gap: 18px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (prefers-reduced-motion: reduce) { .blank :global(svg) { animation: none; } }
</style>
