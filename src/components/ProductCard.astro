---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { img, priceLabel, categories, type Product } from '../data/site';
interface Props { product: Product; eager?: boolean; tint?: string; }
const { product: p, eager = false } = Astro.props;
const tints: Record<string, string> = { hampers: 'var(--p-pink)', caricatures: 'var(--p-mint)', frames: 'var(--p-lav)', keychains: 'var(--p-lemon)', magnets: 'var(--p-sky)', cards: 'var(--p-peach)', collectibles: 'var(--p-lav)' };
const cat = categories.find((c) => c.slug === p.category)?.name;
---
<a class="card" href={`/products/${p.slug}`} style={`--tint:${tints[p.category] ?? 'var(--p-pink)'}`}
   data-category={p.category} data-occasions={p.occasions.join(' ')} data-for={p.for.join(' ')} data-name={`${p.name} ${cat} ${p.blurb}`.toLowerCase()}>
  <span class="ph">
    <Image src={img(p.image)} alt={p.alt} widths={[320, 480, 640]} sizes="(max-width: 640px) 46vw, 280px" loading={eager ? 'eager' : 'lazy'} />
    {p.photoUpload && <span class="tag">Your photo</span>}
  </span>
  <span class="meta">
    <span class="cat">{cat}</span>
    <span class="name">{p.name}</span>
    <span class="row">
      <span class={p.priceFrom ? 'price' : 'price ask'}>{priceLabel(p)}</span>
      <span class="go" aria-hidden="true"><Icon name="arrow" size={16} /></span>
    </span>
  </span>
</a>

<style>
  .card { display: flex; flex-direction: column; background: var(--white); border-radius: var(--radius); padding: 10px; text-decoration: none; color: var(--ink); box-shadow: var(--shadow); transition: transform 240ms var(--ease), box-shadow 240ms var(--ease); }
  .card:hover { transform: translateY(-5px); box-shadow: 0 24px 44px -22px rgba(43, 27, 61, .38); color: var(--ink); }
  .ph { position: relative; display: block; border-radius: 16px; overflow: hidden; background: var(--tint); aspect-ratio: 1; }
  .ph :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 500ms var(--ease); }
  .card:hover .ph :global(img) { transform: scale(1.04); }
  .tag { position: absolute; left: 10px; top: 10px; background: rgba(255, 255, 255, .94); color: var(--ink); font-size: 12px; font-weight: 600; padding: 5px 10px; border-radius: 999px; }
  .meta { display: flex; flex-direction: column; gap: 2px; padding: 14px 8px 6px; flex: 1; }
  .cat { font-size: 12px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .name { font-weight: 600; font-size: 16px; line-height: 1.35; }
  .row { margin-top: auto; padding-top: 8px; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .ask { color: var(--muted); font-weight: 500; font-size: 14px; }
  .go { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--p-pink-2); color: var(--pink-deep); transition: background-color 200ms var(--ease), color 200ms var(--ease), transform 200ms var(--ease); flex: none; }
  .card:hover .go { background: var(--pink); color: #fff; transform: translateX(2px); }
  @media (max-width: 480px) { .meta { padding: 12px 4px 4px; } .name { font-size: 15px; } .cat { font-size: 11px; } }
  @media (prefers-reduced-motion: reduce) { .card, .ph :global(img), .go { transition: none; } .card:hover, .card:hover .ph :global(img) { transform: none; } }
</style>
