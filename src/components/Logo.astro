---
interface Props { small?: boolean; }
const { small = false } = Astro.props;
---
<span class:list={['logo', { small }]}>
  <svg class="cam" viewBox="0 0 48 40" aria-hidden="true" focusable="false">
    <rect x="3" y="9" width="42" height="28" rx="7" fill="#2B1B3D"/>
    <rect x="8" y="5" width="12" height="7" rx="3" fill="#2B1B3D"/>
    <circle cx="24" cy="23" r="10" fill="#FCE4EE"/>
    <circle cx="24" cy="23" r="6.5" fill="#D6336C"/>
    <circle cx="21.6" cy="20.6" r="1.8" fill="#FFFFFF" opacity=".85"/>
    <rect x="36" y="13" width="5" height="3" rx="1.5" fill="#F06292"/>
    <path d="M41 3.2c1.2-1.7 4.4-1.1 4.2 1.3-.1 1.6-2.3 3.1-4.2 4.4-1.9-1.3-4.1-2.8-4.2-4.4-.2-2.4 3-3 4.2-1.3Z" fill="#D6336C"/>
  </svg>
  <span class="words">
    <span class="script">Pictures Art</span>
    <span class="by">BY SIMI</span>
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); }
  .cam { width: 42px; height: 35px; flex: none; transition: transform 260ms var(--ease); }
  .words { display: inline-flex; flex-direction: column; align-items: center; line-height: 1; }
  .script { font-family: var(--script); font-size: 26px; line-height: 1.15; color: var(--ink); white-space: nowrap; }
  .by { margin-top: 1px; background: var(--pink); color: #fff; font: 700 9.5px/1 var(--font); letter-spacing: .18em; padding: 4px 8px 3px; border-radius: 4px; transform: rotate(-2deg); }
  .small .cam { width: 34px; height: 28px; }
  .small .script { font-size: 21px; }
  .small .by { font-size: 8px; }
  :global(a:hover) > .logo .cam { transform: rotate(-8deg); }
</style>
